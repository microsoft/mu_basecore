  CryptoPerfLib.h
  HashPerfTests.c
  AesPerfTests.c
  HmacPerfTests.c
  RsaPerfTests.c
  EcPerfTests.c

[Packages]
  MdePkg/MdePkg.dec
  CryptoPkg/CryptoPkg.dec

[LibraryClasses]
  BaseLib
  DebugLib
  BaseCryptLib
  UnitTestLib
  MmServicesTableLib
  SynchronizationLib
  TimerLib
