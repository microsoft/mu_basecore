[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = CryptoIndicatorTableDxeGoogleTest
  FILE_GUID                      = 1D81839A-A03D-4F4B-928D-8C46AF5F59C4
  MODULE_TYPE                    = HOST_APPLICATION
  VERSION_STRING                 = 1.0

[Sources]
  CryptoIndicatorTableDxeGoogleTest.cpp
  ../CryptoIndicatorTableDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  SecurityPkg/SecurityPkg.dec
  UnitTestFrameworkPkg/UnitTestFrameworkPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  GoogleTestLib
  HobLib
  MemoryAllocationLib
  PcdLib
  UefiBootServicesTableLib
  UefiLib

[Pcd]
  gEfiMdeModulePkgTokenSpaceGuid.PcdAcpiDefaultOemId
  gEfiMdeModulePkgTokenSpaceGuid.PcdAcpiDefaultOemTableId
  gEfiMdeModulePkgTokenSpaceGuid.PcdAcpiDefaultOemRevision
  gEfiMdeModulePkgTokenSpaceGuid.PcdAcpiDefaultCreatorId
  gEfiMdeModulePkgTokenSpaceGuid.PcdAcpiDefaultCreatorRevision

[Protocols]
  gEfiCryptoIndicatorRegistrationProtocolGuid
  gEfiAcpiTableProtocolGuid

[Guids]
  gEfiCryptoIndicatorTableGuid
  gEdkiiEcitCapabilityHobGuid

[BuildOptions]
  MSFT:*_*_*_CC_FLAGS = /EHsc
